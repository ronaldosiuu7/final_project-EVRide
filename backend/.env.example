# Loaded by Uvicorn with --env-file .env. Existing environment variables take precedence.
APP_NAME=EVRide
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evride_db
DB_USER=postgres
DB_PASSWORD=THAY_BANG_MAT_KHAU_CUA_BAN

# JWT & Session Configuration
# Tạo khóa ngẫu nhiên bằng lệnh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-super-secret-jwt-key-at-least-32-bytes-long
JWT_ISSUER=evride-api
JWT_AUDIENCE=evride-web

# Tạo khóa Fernet bằng lệnh: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REFRESH_REPLAY_KEYS=your-fernet-base64-url-safe-32-byte-key=
REFRESH_GRACE_SECONDS=15

# CORS & Cookie Security
AUTH_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false

# Demo-only wallet top-ups; keep disabled outside an explicitly controlled demo.
DEMO_PAYMENTS_ENABLED=false


DEMO_GPS_ENABLED=false